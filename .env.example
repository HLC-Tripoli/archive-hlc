# =============================================================================
# مثال إعدادات البيئة لمنظومة الأرشيف الإلكتروني — هاتف ليبيا
#
# ملف النشر الإنتاجي: انسخه إلى ملف ‎.env‎ بجانب docker-compose.yml ثم عدّل القيم.
#   cp .env.example .env
#   nano .env
# لا تُودِع ‎.env‎ في Git إطلاقاً (متجاهَل في .gitignore)، ولا تضع فيه أي بيانات
# اعتماد غير لازمة وقت التشغيل (لا توكن GitHub هنا — الصور المنشورة عامة).
#
# بيئة التطوير المحلي تستخدم الملف نفسه (docker-compose.dev.yml).
# =============================================================================

# -----------------------------------------------------------------------------
# الصور المنشورة من GHCR (يسحبها النشر الجاهز؛ لا بناء محلي في الإنتاج)
# - api-latest / web-latest: تتبعان أحدث بناء ناجح على الفرع main.
# - للتثبيت الآمن (Reproducible): استبدل الوسم بوسم التزام أو إصدار، مثال:
#     ARCHIVE_API_IMAGE=ghcr.io/mohandl3g/archive-hlc:api-sha-42ccf88
#     ARCHIVE_WEB_IMAGE=ghcr.io/mohandl3g/archive-hlc:web-sha-42ccf88
#   أو إصدار موسوم: api-v1.0.0 / web-v1.0.0 — قائمة الوسوم المنشورة في:
#   https://github.com/Mohandl3G/archive-hlc/pkgs/container/archive-hlc
# - خدمة الترحيلات (migrate) تستخدم صورة ARCHIVE_API_IMAGE نفسها تلقائياً.
# -----------------------------------------------------------------------------
ARCHIVE_API_IMAGE=ghcr.io/mohandl3g/archive-hlc:api-latest
ARCHIVE_WEB_IMAGE=ghcr.io/mohandl3g/archive-hlc:web-latest

# -----------------------------------------------------------------------------
# قاعدة البيانات
# ملاحظة: DATABASE_URL يجب أن يطابق POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# وأن يشير إلى المضيف "db" (اسم خدمة قاعدة البيانات داخل شبكة Compose).
# -----------------------------------------------------------------------------
POSTGRES_USER=hlc
POSTGRES_PASSWORD=غيّر-هذه-إلى-كلمة-مرور-قوية
POSTGRES_DB=archive_hlc
DATABASE_URL=postgres://hlc:غيّر-هذه-إلى-كلمة-مرور-قوية@db:5432/archive_hlc

# -----------------------------------------------------------------------------
# تشغيل الخادم
# NODE_ENV=production يفعّل: كوكي Secure افتراضياً، وثوق الوكيل العكسي.
# PORT منفذ الخادم داخل الحاوية (لا يُنشر للخارج؛ الوصول عبر Angie فقط).
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# PUBLIC_ORIGIN: الأصل العام الذي تُخدَم به المنظومة (يُفرض على الطلبات المتغيّرة).
# اتركه فارغاً خلف وكيل عكسي موحّد، أو اضبطه مثل https://archive.example.com
PUBLIC_ORIGIN=
TRUST_PROXY=true

# مدة الجلسة بالساعات، وإلزام الكوكي على HTTPS في الإنتاج.
# ملاحظة مهمة: مع النشر عبر HTTPS اجعل COOKIE_SECURE=true (الافتراضي في الإنتاج).
# عند اختبار محلي بدون HTTPS اضبطها false مؤقتاً فقط.
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# أقصى حجم للمرفق الواحد بالميجابايت.
# الحد الأقصى الفعلي محفور أيضاً في صورة الواجهة (client_max_body_size في
# deploy/angie/angie.conf). القيم حتى 32MB مطابقة للصور المنشورة؛ رفع الحد فوق
# ذلك يتطلب تعديل الإعداد وإعادة نشر صورة الواجهة عبر سير عمل GitHub Actions.
UPLOAD_MAX_MB=25

# -----------------------------------------------------------------------------
# تحسين المرفقات (PDF والصور) قبل التخزين
# - PROCESSING_TMP_DIR: مجلد عمل مؤقت داخل الحاوية؛ تُنشأ تحته مجلدات 0700 لكل
#   رفع وتُحذف دائماً بعد الاختيار أو الفشل. الافتراضي داخل الصورة /tmp/archive-hlc.
# - OPTIMIZE_TIMEOUT_SECONDS: سقف زمن تحسين المرفق الواحد (1..300 ثانية).
# - OPTIMIZE_CONCURRENCY: أقصى عدد عمليات تحسين متزامنة (1..8).
# عند تعذّر التحسين أو تجاوز المهلة يُحفظ الملف الأصلي كما هو.
PROCESSING_TMP_DIR=/tmp/archive-hlc
OPTIMIZE_TIMEOUT_SECONDS=20
OPTIMIZE_CONCURRENCY=2

# منفذ الواجهة المنشور على المضيف (Angie يستمع داخلياً على 80).
WEB_PORT=8080

# -----------------------------------------------------------------------------
# تخزين المرفقات محلياً على نظام ملفات المضيف (لا يوجد أي اعتماد على S3)
# الملفات المرفوعة تُحفظ في مجلد دائم على المضيف يُوصَل داخل حاوية api إلى /data/uploads
# ويصل إليه الخادم وحده؛ خدمة الواجهة (Angie) لا ترى هذا المجلد إطلاقاً.
#
# ARCHIVE_UPLOADS_PATH: مسار المجلد على مضيف Docker (نسبي بجانب docker-compose.yml
#   أو مطلق لقرص/وحدة تخزين مخصّصة، مثال: /srv/archive-hlc/uploads).
# UPLOADS_DIR: مسار المجلد داخل الحاوية؛ اتركه /data/uploads إلا لحالات خاصة.
#
# مهم جداً: أنشئ المجلد قبل أول تشغيل وامنحه ملكية مستخدم تشغيل الحاوية (uid=1000):
#   mkdir -p "./archive/files/uploads"
#   sudo chown 1000:1000 "./archive/files/uploads"
#   sudo chmod 750 "./archive/files/uploads"
# بدون ذلك سيفشل رفع المرفقات (وفحص الجاهزية /api/v1/ready سيرجع 503).
# -----------------------------------------------------------------------------
ARCHIVE_UPLOADS_PATH=./archive/files/uploads
UPLOADS_DIR=/data/uploads

# -----------------------------------------------------------------------------
# حدود المعدّل (طلبات)
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SENSITIVE_MAX=20
RATE_LIMIT_GLOBAL_MAX=600
