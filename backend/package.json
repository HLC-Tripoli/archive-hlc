{
  "name": "archive-hlc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "خادم واجهة برمجة تطبيقات منظومة الأرشيف الإلكتروني - هاتف ليبيا",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
